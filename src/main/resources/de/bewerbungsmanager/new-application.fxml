<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>

<VBox xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="de.bewerbungsmanager.NewApplicationController"
    alignment="CENTER"
    spacing="15">

    <Label text="Neue Bewerbung anlegen"></Label>

    <TextField fx:id="unternehmenField" promptText="Unternehmen"></TextField>

    <TextField fx:id="stelleField" promptText="Stelle"></TextField>

    <ComboBox fx:id="statusBox" promptText="Status auswählen"></ComboBox>

    <TextField fx:id="erinnerungsIntervallField" promptText="Erinnerungsintervall in Tagen"></TextField>

    <Button text="Speichern" onAction="#speichern"></Button>

    <Button text="Abbrechen" onAction="#abbrechen"></Button>

</VBox>